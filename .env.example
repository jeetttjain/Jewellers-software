# Server Environment
NODE_ENV=development
API_PORT=3001
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:5173

# Frontend Environment (Vercel / Web)
# In production, set this to your deployed Render API URL (e.g. https://your-render-service.onrender.com)
VITE_API_URL=http://localhost:3001

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jewellery_pos_db

# Security & Sessions
JWT_SECRET=change_this_to_a_secure_random_64_char_string_for_jwt
COOKIE_SECRET=change_this_to_a_secure_random_64_char_string_for_cookie

# Shop Default Profile
DEFAULT_SHOP_NAME="Kamal Jewellers"
DEFAULT_SHOP_CODE="KJ"
DEFAULT_FINANCIAL_YEAR="26-27"
DEFAULT_TAX_PERCENT="3.00"
